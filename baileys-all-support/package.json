{
  "name": "baileys-all-support",
  "type": "module",
  "version": "1.1.0",
  "description": "Baileys ALL-SUPPORT build — a 3-way merge of WhiskeySockets/Baileys v7.0.0-rc14 (upstream fixes: tctoken/privacy tokens, media upload backpressure, account reachout & message capping, companion registration, USync username protocol) with ourin-baileys v9.0.21 mods (interactive/native-flow messages, AI rich responses (ORich/AIRich), albums, sticker packs, newsletters + auto-follow, status mentions (sendStatusMention/swgc/sendPreview), Dugong helper, built-in VoIP voice-call engine).",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js"
  ],
  "keywords": [
    "baileys",
    "baileys-all",
    "whiskeysockets",
    "ourin-baileys",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "multi-device",
    "bot",
    "automation",
    "interactive-messages",
    "newsletter",
    "channels",
    "sticker-pack",
    "voip",
    "voice-call",
    "status-mention"
  ],
  "scripts": {
    "example": "node example/basic.js",
    "test:import": "node test/import.test.mjs"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.0",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "^0.5.4",
    "ws": "^8.13.0"
  },
  "peerDependencies": {
    "@roamhq/wrtc": "*",
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.0",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "@roamhq/wrtc": {
      "optional": true
    },
