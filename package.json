{
  "name": "ahsans-baileys",
  "type": "module",
  "version": "1.2.0",
  "description": "AHSANS-BAILEYS — hardened Baileys ALL-SUPPORT build. 3-way merge of WhiskeySockets/Baileys v7.0.0-rc14 (tctoken/privacy tokens, media upload backpressure, account reachout & message capping, companion registration, USync username protocol) with ourin-baileys v9.0.21 mods (interactive/native-flow messages, AI rich responses (ORich/AIRich), albums, sticker packs, newsletters + opt-in auto-follow, status mentions, Dugong helper, VoIP voice-call engine). Node.js >= 24, ESM-only, Pterodactyl/container friendly.",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./WAProto": {
      "types": "./WAProto/index.d.ts",
      "default": "./WAProto/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js"
  ],
  "keywords": [
    "ahsans-baileys",
    "baileys",
    "baileys-all",
    "whiskeysockets",
    "ourin-baileys",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "multi-device",
    "bot",
    "automation",
    "interactive-messages",
    "newsletter",
    "channels",
    "sticker-pack",
    "voip",
    "voice-call",
    "status-mention"
  ],
  "scripts": {
    "example": "node example/basic.js",
    "test": "node --test test/",
    "test:import": "node test/import.test.mjs",
    "check:types": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck lib/index.d.ts",
    "check:engine": "node engine-requirements.js"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.0",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "^0.5.4",
    "ws": "^8.13.0"
  },
  "peerDependencies": {
    "@roamhq/wrtc": "*",
    "audio-decode": "^2.1.3",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.0",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "@roamhq/wrtc": {
      "optional": true
    },
    "audio-decode": {
      "optional": true
    },
    "fluent-ffmpeg": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "protobufjs-cli": "^1.1.6",
    "typescript": "5.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahsansdr11-spec/AHSANS-BAILEYS.git"
  },
  "homepage": "https://github.com/ahsansdr11-spec/AHSANS-BAILEYS#readme",
  "bugs": "https://github.com/ahsansdr11-spec/AHSANS-BAILEYS/issues"
}
